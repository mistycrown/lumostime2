<?xml version="1.0" encoding="utf-8"?>
<!-- 2026-10-29: Matches QUICK TODO / TODAY + PIN typography, insets and compact header. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <LinearLayout
            android:id="@+id/widget_daily_list_open"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:contentDescription="@string/widget_daily_list_open">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:ellipsize="end"
                android:letterSpacing="0.08"
                android:maxLines="1"
                android:text="@string/widget_daily_list_title"
                android:textColor="#1F1B16"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_daily_list_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="monospace"
                android:ellipsize="end"
                android:letterSpacing="0.09"
                android:maxLines="1"
                android:textColor="#6C6359"
                android:textSize="9sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_daily_list_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:fontFamily="monospace"
            android:text="0/0"
            android:textColor="#6C6359"
            android:textSize="9sp" />
        <ImageView
            android:id="@+id/widget_daily_list_refresh"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="8dp"
            android:padding="2dp"
            android:contentDescription="@string/widget_refresh"
            android:src="@drawable/widget_todo_pin_refresh_icon"
            android:scaleType="centerInside"
            android:tint="#6C6359" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">
        <ListView
            android:id="@+id/widget_daily_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:cacheColorHint="@android:color/transparent"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="0dp"
            android:fadingEdge="none"
            android:listSelector="@android:color/transparent"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:scrollbarSize="2dp"
            android:scrollbarStyle="insideInset"
            android:scrollbarThumbVertical="@drawable/widget_todo_pin_scrollbar_thumb" />
        <TextView
            android:id="@+id/widget_daily_list_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/widget_daily_check_empty"
            android:fontFamily="sans-serif-light"
            android:textColor="#8A8175"
            android:textSize="12sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
