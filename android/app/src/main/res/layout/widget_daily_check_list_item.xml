<?xml version="1.0" encoding="utf-8"?>
<!-- 2026-10-29: Shares QUICK TODO's 28dp rows, leading checkbox and light body typography. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="28dp"
        android:orientation="horizontal"
        android:paddingTop="2dp"
        android:paddingBottom="3dp">
        <ImageView
            android:id="@+id/widget_daily_list_item_action"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="@string/widget_daily_list_check"
            android:padding="3dp"
            android:src="@drawable/widget_todo_pin_checkbox_unchecked" />
        <ImageView
            android:id="@+id/widget_daily_list_item_icon_image"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="5dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:visibility="gone" />
        <TextView
            android:id="@+id/widget_daily_list_item_icon_text"
            android:layout_width="14dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:gravity="center"
            android:fontFamily="sans-serif-light"
            android:textColor="#6C6359"
            android:textSize="12sp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/widget_daily_list_item_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-light"
            android:maxLines="1"
            android:textColor="#2E2822"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/widget_daily_list_item_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="monospace"
            android:textColor="#6C6359"
            android:textSize="9sp"
            android:visibility="gone" />
    </LinearLayout>
    <TextView
        android:id="@+id/widget_daily_list_item_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#14362C21" />
</LinearLayout>
